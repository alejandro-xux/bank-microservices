{
  "name": "Consulta: céntimos .98 → 025 NF (el core nunca lo registró)",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/core/consultas",
    "bodyPatterns": [
      {
        "matches": "^QRY.{29}\\d{13}98$"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/plain"
    },
    "body": "{{regexExtract request.body '^(?:TRX|QRY)(.{14})(.{12})(?:.{28})?(.{3})(.{15})$' 'p'}}025QRY{{p.0}}{{p.1}}{{p.2}}{{p.3}}NF",
    "transformers": [
      "response-template"
    ]
  }
}
