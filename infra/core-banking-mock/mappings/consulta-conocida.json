{
  "metadata": {
    "comentario": "Consulta de un id-op que el core recibió: responde lo que registró (000 OK o 057 RC)"
  },
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/core/consultas",
    "bodyPatterns": [
      {
        "matches": "^QRY.{44}$"
      }
    ],
    "customMatcher": {
      "name": "state-matcher",
      "parameters": {
        "hasContext": "{{regexExtract request.body '^(?:TRX|QRY).{14}(.{12})' 'k'}}{{k.0}}"
      }
    }
  },
  "response": {
    "status": 200,
    "body": "{{regexExtract request.body '^(?:TRX|QRY).{14}(.{12})' 'k'}}{{regexExtract request.body '^(?:TRX|QRY)(.{14})(.{12})(?:.{28})?(.{3})(.{15})$' 'p'}}{{state context=k.0 property='result'}}QRY{{p.0}}{{p.1}}{{p.2}}{{p.3}}{{state context=k.0 property='estado'}}",
    "transformers": [
      "response-template"
    ]
  }
}
