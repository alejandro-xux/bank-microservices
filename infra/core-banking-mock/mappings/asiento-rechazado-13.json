{
  "metadata": {
    "comentario": "Céntimos .13: el core rechaza (057 RC) y lo recuerda por id-op"
  },
  "priority": 2,
  "request": {
    "method": "POST",
    "url": "/core/asientos",
    "bodyPatterns": [
      {
        "matches": "^TRX.{57}\\d{13}14$"
      }
    ]
  },
  "response": {
    "status": 200,
    "body": "{{regexExtract request.body '^(?:TRX|QRY)(.{14})(.{12})(?:.{28})?(.{3})(.{15})$' 'p'}}057TRX{{p.0}}{{p.1}}{{p.2}}{{p.3}}RC",
    "transformers": [
      "response-template"
    ]
  },
  "serveEventListeners": [
    {
      "name": "recordState",
      "parameters": {
        "context": "{{regexExtract request.body '^(?:TRX|QRY).{14}(.{12})' 'k'}}{{k.0}}",
        "state": {
          "result": "057",
          "estado": "RC"
        }
      },
      "requestPhases": [
        "BEFORE_RESPONSE_SENT"
      ]
    }
  ]
}
