{
  "name": "Asiento rechazado: céntimos .13 → 057 RC",
  "priority": 1,
  "request": {
    "method": "POST",
    "url": "/core/asientos",
    "bodyPatterns": [
      {
        "matches": "^TRX.{57}\\d{13}13$"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/plain"
    },
    "body": "{{regexExtract request.body '^(?:TRX|QRY)(.{14})(.{12})(?:.{28})?(.{3})(.{15})$' 'p'}}057TRX{{p.0}}{{p.1}}{{p.2}}{{p.3}}RC",
    "transformers": [
      "response-template"
    ]
  }
}
