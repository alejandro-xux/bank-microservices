{
  "name": "Asiento registrado: cualquier trama de 75 caracteres → 000 OK",
  "priority": 5,
  "request": {
    "method": "POST",
    "url": "/core/asientos",
    "bodyPatterns": [
      {
        "matches": "^TRX.{72}$"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/plain"
    },
    "body": "{{regexExtract request.body '^(?:TRX|QRY)(.{14})(.{12})(?:.{28})?(.{3})(.{15})$' 'p'}}000TRX{{p.0}}{{p.1}}{{p.2}}{{p.3}}OK",
    "transformers": [
      "response-template"
    ]
  }
}
